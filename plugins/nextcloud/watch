#!/bin/sh
# Stays on the Nextcloud client's socket and passes on what it says: a line
# (UPDATE_VIEW) whenever something in a folder it syncs changed, which is
# when Folio should ask again how files stand. It ends when the client isn't
# running, or quits; Folio starts it again.
. "${0%/*}/socket.sh"
exec socat -u "UNIX-CONNECT:$socket" -
